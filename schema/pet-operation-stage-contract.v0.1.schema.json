        "additionalProperties": false,
        "properties": {
          "acknowledgment_slots": {
            "enum": [
              "empty",
              "empty-or-any-subset-after-both-contributions",
              "both"
            ]
          },
          "cleanup_requirement": {
            "const": "required"
          },
          "cleanup_state_before": {
            "const": "NOT_STARTED"
          },
          "commitment_pair": {
            "enum": [
              "required",
              "none"
            ]
          },
          "consent_state": {
            "enum": [
              "none",
              "pending",
              "complete"
            ]
          },
          "contribution_slots": {
            "enum": [
              "empty",
              "any-subset",
              "both"
            ]
          },
          "disclosure_state": {
            "enum": [
              "none",
              "authorized"
            ]
          },
          "evaluation_attempt": {
            "enum": [
              "required",
              "none"
            ]
          },
          "evaluation_deadline": {
            "enum": [
              "required",
              "none"
            ]
          },
          "execution_authorization_digest": {
            "enum": [
              "required",
              "none"
            ]
          },
          "participant_binding": {
            "enum": [
              "required",
              "none"
            ]
          },
          "query_budget_effect": {
            "enum": [
              "release-if-not-started",
              "preserve-consumed"
            ]
          },
          "query_budget_state": {
            "enum": [
              "NONE",
              "RESERVED",
              "CONSUMED"
            ]
          },
          "receipt_state": {
            "enum": [
              "none",
              "present-iff-acknowledgment",
              "accepted"
            ]
          },
          "resource_policy_binding": {
            "enum": [
              "required",
              "none"
            ]
          },
          "result_state": {
            "enum": [
              "none",
              "proposed-iff-acknowledgment",
              "accepted"
            ]
          },
          "resulting_phase": {
            "const": "ABORTED"
