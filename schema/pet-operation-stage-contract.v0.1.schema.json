          "source_phase": {
            "enum": [
              "CREATED",
              "PARTICIPANTS_BOUND",
              "COMMITMENTS_PENDING",
              "COMMITTED",
              "EVALUATING",
              "RESULT_ACCEPTED",
              "CONSENT_PENDING",
              "DISCLOSURE_AUTHORIZED"
