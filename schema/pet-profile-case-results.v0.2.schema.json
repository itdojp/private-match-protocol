{
  "$id": "https://github.com/itdojp/private-match-protocol/raw/main/schema/pet-profile-case-results.v0.2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_status": {
      "const": "experimental"
    },
    "catalog_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "operation_stage_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "record_type": {
      "const": "pet-profile-executable-case-results"
    },
    "result_set_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accepted_transition_ids": {
            "items": {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 128,
            "type": "array",
            "uniqueItems": true
          },
          "case_id": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "input_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "input_path": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "observer_digest": {
            "anyOf": [
              {
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "operation_effect": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "protocol_outcome": {
            "enum": [
              "accepted",
              "rejected",
              "no-op",
              "terminal",
              "not-evaluated"
            ]
          },
          "query_budget_effect": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "result_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "result_visibility": {
            "maxLength": 2048,
            "minLength": 1,
            "type": "string"
          },
          "resulting_phase": {
            "type": [
              "string",
              "null"
            ]
          },
          "runner_status": {
            "enum": [
              "pass",
              "fail",
              "skip",
              "unsupported",
              "timeout",
              "tool-error"
            ]
          },
          "transcript_mutated": {
            "type": "boolean"
          }
        },
        "required": [
          "case_id",
          "input_path",
          "input_digest",
          "observer_digest",
          "runner_status",
          "protocol_outcome",
          "accepted_transition_ids",
          "resulting_phase",
          "operation_effect",
          "transcript_mutated",
          "query_budget_effect",
          "result_visibility",
          "result_digest"
        ],
        "type": "object"
      },
      "minItems": 12,
      "type": "array"
    },
    "schema_version": {
      "const": "0.2"
    },
    "status_counts": {
      "additionalProperties": false,
      "properties": {
        "no_op": {
          "minimum": 0,
          "type": "integer"
        },
        "pass": {
          "minimum": 0,
          "type": "integer"
        },
        "terminal": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pass",
        "terminal",
        "no_op"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "artifact_status",
    "catalog_digest",
    "operation_stage_digest",
    "results",
    "status_counts",
    "result_set_digest"
  ],
  "type": "object"
}
